@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="auth-page">
    <div class="container">
        <div class="card auth-card">

            <!-- Lado izquierdo: marca -->
            <div class="auth-aside">
                <img class="logo-dark" src="~/img/logo-blanco.png" alt="Rhino Fitness" />
                <img class="logo-light" src="~/img/logo-negro.png" alt="Rhino Fitness" />
                <h1>Bienvenido<br />de vuelta.</h1>
                <p>Lleva control de tus entrenamientos con RhinoApp</p>
                
            </div>

            <!-- Lado derecho: formulario -->
            <div class="auth-form">
                <h2>Iniciar sesión</h2>
                <p class="subtitle">Ingresa con el correo registrado en el gimnasio.</p>

                @if (TempData["Aviso"] != null)
                {
                    <div class="alert-info">@TempData["Aviso"]</div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div class="form-group">
                        <label class="form-label" for="correo">Correo</label>
                        <div class="input-icon">
                            <svg class="svg-icon" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 6l-10 7L2 6" /></svg>
                            <input class="form-control" type="email" id="correo" name="correo" placeholder="tucorreo@correo.com" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="contrasena">Contraseña</label>
                        <div class="input-icon">
                            <svg class="svg-icon" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                            <input class="form-control" type="password" id="contrasena" name="contrasena" placeholder="••••••••" required />
                        </div>
                    </div>

                    <div class="auth-row">
                        <label><input type="checkbox" name="recordarme" /> Recordarme</label>
                        <a href="#">¿Olvidaste tu contraseña?</a>
                    </div>

                    <button type="submit" class="btn btn-lg btn-block">Iniciar sesión</button>
                </form>

                <div class="auth-note">
                    
                   
                </div>
            </div>

        </div>
    </div>
</section>