@model RhynoPerformance.Models.LandingViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Inicio";
    const string WhatsAppGym = "50662860026";

    string Colones(decimal monto) =>
        "₡" + monto.ToString("#,0", CultureInfo.InvariantCulture).Replace(",", ".");

    string WaLink(string numero, string mensaje) =>
        $"https://wa.me/{numero}?text={Uri.EscapeDataString(mensaje)}";
}

<!-- ============ HERO ============ -->
<section class="hero" id="inicio">
    <div class="container">
        <div>
            <span class="badge badge-yellow">Funcionales · Hyrox · Cross · Cardio Dance · Cardio Step · Gym</span>
            <h1>Tu mejor versión<br /><span class="accent">empieza aquí.</span></h1>
            <p class="hero-lead">
                Entrena con acompañamiento real: tu entrenador diseña tu plan,
                tú lo sigues desde la app y ves tu progreso semana a semana.
            </p>
            <div class="hero-actions">
                <a href="#planes" class="btn btn-lg">Ver planes</a>
                <a href="#clases" class="btn btn-ghost btn-lg">Horario de clases</a>
            </div>
            <div class="hero-stats">
                <div><strong class="stat-orange">7 días</strong><span>Abierto toda la semana</span></div>
                <div><strong class="stat-cyan">6</strong><span>Disciplinas</span></div>
                <div><strong class="stat-purple">8 sem.</strong><span>Renovación de tu rutina</span></div>
            </div>
        </div>

        <!-- Vista previa de la app -->
        <div class="phone" aria-hidden="true">
            <div class="phone-notch"></div>
            <small>Hola, María</small>
            <h4>Mi plan</h4>
            <div class="phone-card">
                <small>Plan Fuerza · 8 semanas</small>
                <b>Semana 4 de 8</b>
                <div class="segbar">
                    <i class="done"></i><i class="done"></i><i class="done"></i><i class="current"></i>
                    <i></i><i></i><i></i><i></i>
                </div>
            </div>
            <div class="phone-card today">
                <span class="tag">HOY · JUEVES</span>
                <b>Espalda y bíceps</b>
                <small>6 ejercicios · 45 min</small>
                <div class="phone-btn">▶ Iniciar entrenamiento</div>
            </div>
            <div class="phone-card">
                <small>Mi avance</small>
                <svg viewBox="0 0 200 50" style="width:100%;height:46px" preserveAspectRatio="none">
                    <polyline points="0,8 40,14 80,20 120,26 160,34 200,42" fill="none" stroke="#84CBD5" stroke-width="3" />
                    <polyline points="0,14 40,18 80,24 120,27 160,32 200,36" fill="none" stroke="#F37B29" stroke-width="3" />
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- ============ BENEFICIOS ============ -->
<section class="section" id="beneficios">
    <div class="container">
        <div class="section-head">
            <span class="badge badge-orange">Lo que ofrecemos</span>
            <h2>Un gimnasio que te da seguimiento</h2>
            <p>Clases guiadas, rutinas hechas para ti y un registro claro de cómo vas avanzando.</p>
        </div>

        <div class="benefits">
            <article class="card benefit">
                <div class="benefit-icon badge-cyan">
                    <svg class="svg-icon" viewBox="0 0 24 24"><path d="M6.5 6.5v11M17.5 6.5v11M3 9v6M21 9v6M6.5 12h11" /></svg>
                </div>
                <h3>Clases grupales</h3>
                <p>Funcionales, Hyrox, Cross, Cardio Dance y Cardio Step con entrenadores certificados.</p>
            </article>
            <article class="card benefit">
                <div class="benefit-icon badge-purple">
                    <svg class="svg-icon" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2" /><path d="M9 4V3h6v1M9 10h6M9 14h6M9 18h4" /></svg>
                </div>
                <h3>Rutina personalizada</h3>
                <p>Te armamos una rutina a tu medida y la renovamos cada 8 semanas.</p>
            </article>
            <article class="card benefit">
                <div class="benefit-icon badge-orange">
                    <svg class="svg-icon" viewBox="0 0 24 24"><path d="M3 3v18h18" /><path d="M7 15l4-4 3 3 5-6" /></svg>
                </div>
                <h3>Seguimiento de avance</h3>
                <p>Peso, porcentaje de grasa y medidas registradas en tu perfil.</p>
            </article>
            <article class="card benefit">
                <div class="benefit-icon badge-yellow">
                    <svg class="svg-icon" viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="2" /><path d="M11 18h2" /></svg>
                </div>
                <h3>Todo en la app</h3>
                <p>Consulta tu rutina del día y marca cada ejercicio mientras entrenas.</p>
            </article>
        </div>
    </div>
</section>

<!-- ============ HORARIO DE CLASES ============ -->
<section class="section" id="clases" style="padding-top:0">
    <div class="container">
        <div class="section-head">
            <span class="badge badge-yellow">Horario</span>
            <h2>Clases y horarios</h2>
            <p>El gimnasio, Cardio Dance y Cardio Step están en todos los planes. Funcionales, Hyrox y Cross son parte del Plan Premium.</p>
        </div>

        <div class="classes">
            @foreach (var clase in Model.Clases)
            {
                <article class="card class-card accent-@clase.Color">
                    <div class="class-head">
                        <h3>@clase.Nombre</h3>
                        @if (clase.SoloPremium)
                        {
                            <span class="badge badge-orange">Premium</span>
                        }
                        else
                        {
                            <span class="badge badge-green">Todos los planes</span>
                        }
                    </div>
                    <ul>
                        @foreach (var h in clase.Horarios)
                        {
                            <li><svg class="svg-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>@h</li>
                        }
                    </ul>
                </article>
            }
        </div>
    </div>
</section>

<!-- ============ LA APP ============ -->
<section class="section app-section" id="app">
    <div class="container">
        <div>
            <div class="section-head">
                <span class="badge badge-purple">La app</span>
                <h2>Tu entrenamiento, organizado semana a semana</h2>
                <p>Cada cliente tiene acceso a su propio panel con el plan que le asignó su entrenador.</p>
            </div>
            <ol class="app-steps">
                <li><span class="step-num">1</span><div><b>Tu entrenador crea tu plan</b><p>Define cuántas semanas dura y lo divide en sesiones: brazos, piernas, core…</p></div></li>
                <li><span class="step-num">2</span><div><b>Entrenas desde la app</b><p>Abres la sesión del día, ves cada ejercicio con su video y lo marcas como hecho.</p></div></li>
                <li><span class="step-num">3</span><div><b>Ves tu progreso</b><p>Gráficos de peso y grasa corporal, tu racha y el calendario de días entrenados.</p></div></li>
            </ol>
        </div>
        <div class="card" style="padding:24px">
            <span class="badge badge-orange">Semana 4</span>
            <h3 style="margin:12px 0 16px">Plan Fuerza — Fase 1</h3>
            <div class="segbar" style="margin-bottom:18px">
                <i class="done"></i><i class="done"></i><i class="current"></i><i></i>
            </div>
            <p class="text-muted" style="font-size:14px">Lunes · Pecho y tríceps ✓</p>
            <p class="text-muted" style="font-size:14px">Miércoles · Piernas y hombros ✓</p>
            <p style="font-size:14px;font-weight:600;color:var(--primary-text)">Jueves · Espalda y bíceps (hoy)</p>
            <p class="text-muted" style="font-size:14px">Viernes · Core y cardio</p>
        </div>
    </div>
</section>

<!-- ============ PLANES ============ -->
<section class="section" id="planes">
    <div class="container">
        <div class="section-head">
            <span class="badge badge-cyan">Planes</span>
            <h2>Elige cómo quieres entrenar</h2>
            <p>Precios mensuales. Todos los planes incluyen acceso a la app y seguimiento de tu entrenador.</p>
        </div>

        <div class="plans">
            @foreach (var plan in Model.Planes)
            {
                <article class="card plan @(plan.Destacado ? "featured" : "")">
                    @if (plan.Destacado)
                    {
                        <span class="badge badge-orange popular">Más completo</span>
                    }
                    <span class="badge badge-@plan.ColorBadge" style="align-self:flex-start">@plan.Nombre</span>
                    <div class="plan-price">@Colones(plan.Precio) <small>@plan.Periodo</small></div>
                    @if (!string.IsNullOrEmpty(plan.Nota))
                    {
                        <p class="plan-note">@plan.Nota</p>
                    }
                    <ul>
                        @foreach (var b in plan.Beneficios)
                        {
                            <li><svg class="svg-icon" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5" /></svg>@b</li>
                        }
                    </ul>
                    <a href="@WaLink(WhatsAppGym, $"Hola, me interesa el {plan.Nombre}.")" target="_blank" rel="noopener"
                       class="btn btn-block @(plan.Destacado ? "" : "btn-ghost")">Quiero este plan</a>
                </article>
            }
        </div>
    </div>
</section>

<!-- ============ ENTRENADORES ============ -->
<section class="section" id="entrenadores" style="padding-top:0">
    <div class="container">
        <div class="section-head">
            <span class="badge badge-purple">Nuestro equipo</span>
            <h2>Entrena con profesionales</h2>
            <p>Entrenadoras certificadas que diseñan tu plan, corrigen tu técnica y te acompañan en cada etapa.</p>
        </div>

        <div class="trainers">
            @foreach (var e in Model.Entrenadores)
            {
                <article class="card trainer">
                    <div class="trainer-photo badge-@e.Color">
                        <span class="trainer-initials">@e.Iniciales</span>
                        <img src="@e.Foto" alt="Foto de @e.Nombre" loading="lazy" onerror="this.style.display='none'" />
                    </div>
                    <div class="trainer-body">
                        <div>
                            <h3>@e.Nombre</h3>
                            <p class="trainer-title">@e.Titulo</p>
                        </div>
                        <div class="chips">
                            @foreach (var esp in e.Especialidades)
                            {
                                <span class="badge">@esp</span>
                            }
                        </div>
                        <a href="@WaLink(e.WhatsApp ?? WhatsAppGym, $"Hola, quiero información sobre entrenamiento personal con {e.Nombre}.")"
                           target="_blank" rel="noopener" class="btn btn-ghost btn-block">Entrenar con @e.Nombre.Split(' ')[0]</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- ============ GALERÍA ============ -->
<section class="section" id="galeria" style="padding-top:0">
    <div class="container">
        <div class="section-head">
            <h2>Conoce el gimnasio</h2>
        </div>
        <div class="gallery">
            @foreach (var foto in Model.Galeria)
            {
                <figure class="@(foto.Ancha ? "wide" : "")">
                    <img src="@foto.Imagen" alt="@foto.Titulo" loading="lazy" onerror="this.style.display='none'" />
                    <figcaption class="badge">@foto.Titulo</figcaption>
                </figure>
            }
        </div>
    </div>
</section>

<!-- ============ UBICACIÓN Y CONTACTO ============ -->
<section class="section" id="contacto" style="padding-top:0">
    <div class="container">
        <div class="section-head">
            <span class="badge badge-orange">Ubicación y contacto</span>
            <h2>Te esperamos</h2>
        </div>
        <div class="contact">
            <div class="map">
                <iframe src="https://maps.google.com/maps?q=Pal%C3%AD%20San%20Isidro%20de%20Heredia&z=16&output=embed"
                        loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Ubicación de Rhino Fitness Center"></iframe>
            </div>
            <div class="card contact-info">
                <div class="contact-item">
                    <svg class="svg-icon" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
                    <div><b>Dirección</b><span>100 m al este del Palí de San Isidro de Heredia</span></div>
                </div>
                <div class="contact-item">
                    <svg class="svg-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                    <div><b>Horario del gimnasio</b><span>Lunes a viernes 5am–9pm · Sábado 8am–3pm · Domingo 8am–1pm</span></div>
                </div>
                <div class="contact-item">
                    <svg class="svg-icon" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
                    <div><b>WhatsApp</b><span>6286-0026</span></div>
                </div>
                <div class="contact-item">
                    <svg class="svg-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /></svg>
                    <div><b>Instagram</b><span>@@rhinofitnesscenter25</span></div>
                </div>
                <a class="btn btn-block" href="@WaLink(WhatsAppGym, "Hola, quiero información sobre los planes.")" target="_blank" rel="noopener">Escribir por WhatsApp</a>
            </div>
        </div>
    </div>
</section>