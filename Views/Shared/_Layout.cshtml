<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Inicio") · Rhino Fitness Center</title>

    @* Aplica el tema guardado ANTES de pintar la página (evita el parpadeo) *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('rhino-theme');
                if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img class="logo-dark" src="~/img/logo-blanco.png" alt="Rhino Fitness" />
                <img class="logo-light" src="~/img/logo-negro.png" alt="Rhino Fitness" />
                <span>RHINO FITNESS CENTER</span>
            </a>

            <nav class="main-nav" id="main-nav">
                <a asp-controller="Home" asp-action="Index" asp-fragment="inicio">Inicio</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="beneficios">Clases</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="planes">Planes</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="app">Beneficios</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="contacto">Ubicación y contacto</a>
            </nav>

            <div class="header-actions">
                <button type="button" class="theme-switch theme-toggle" role="switch" aria-checked="true" aria-label="Modo oscuro">
                    <svg class="svg-icon icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                    <svg class="svg-icon icon-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                    <span class="knob"></span>
                </button>
                <a class="btn" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                <button type="button" class="icon-btn menu-toggle" aria-label="Abrir menú" aria-controls="main-nav" aria-expanded="false">
                    <svg class="svg-icon" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span>© @DateTime.Now.Year Rhino Fitness Center · San Isidro de Heredia</span>
            <div class="social">
                <a class="ig" href="https://www.instagram.com/rhinofitnesscenter25" target="_blank" rel="noopener" aria-label="Instagram">
                    <svg viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.9.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.9.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.9-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.9-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm5.1-9.4a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z" /></svg>
                </a>
                <a class="fb" href="https://www.facebook.com/share/1DrDb8pWaG/" target="_blank" rel="noopener" aria-label="Facebook">
                    <svg viewBox="0 0 24 24"><path d="M14 8.5V6.6c0-.8.2-1.3 1.4-1.3H17V2.2c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7.5v3.4h2.8V22H14V11.9h2.8l.4-3.4H14z" /></svg>
                </a>
                <a class="wa" href="https://wa.me/50662860026" target="_blank" rel="noopener" aria-label="WhatsApp">
                    <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-.7-.3-1.5-.7-2.2-1.4-.6-.5-1-1.2-1.2-1.4-.1-.2 0-.4.1-.5l.4-.5.3-.5v-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 1.9 2.9 4.6 4.1 1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z" /></svg>
                </a>
            </div>
        </div>
    </footer>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>